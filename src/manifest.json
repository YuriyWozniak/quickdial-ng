{

  "manifest_version": 2,
  "name": "Quick Dial NG",
  "description": "Speed dial for the new tab and home page, with tiles from a bookmarks folder. Independent, optimized fork of Quick Dial by MatMoul.",
  "version": "0.4.1",
  "author": "YuriyWozniak (fork of Quick Dial by MatMoul)",
  "homepage_url": "https://github.com/YuriyWozniak/quickdial-ng",
  "developer": {
    "name": "YuriyWozniak",
    "url": "https://github.com/YuriyWozniak/quickdial-ng"
  },

  "icons": {
    "48": "img/icon.svg",
    "96": "img/icon.svg"
  },

  "permissions": [
    "storage",
    "bookmarks",
    "contextMenus",
    "tabs",
    "<all_urls>"
  ],

  "background": {
    "scripts": ["js/themes.js", "js/background.js"]
  },
  
  "browser_action": {
    "default_icon": "img/icon.svg",
    "theme_icons": [
      { "light": "img/icon-light.svg", "dark": "img/icon-dark.svg", "size": 16 },
      { "light": "img/icon-light.svg", "dark": "img/icon-dark.svg", "size": 32 }
    ]
  },

  "chrome_url_overrides" : {
    "newtab": "dial.html"
  },

  "chrome_settings_overrides": {
    "homepage": "dial.html"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "quickdial-ng@yuriywozniak",
      "strict_min_version": "140.0",
      "update_url": "https://raw.githubusercontent.com/YuriyWozniak/quickdial-ng/develop/updates.json",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },

  "default_locale": "en"
}

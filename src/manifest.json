{

  "manifest_version": 2,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "0.8.0",
  "author": "YuriyWozniak (fork of Quick Dial by MatMoul)",
  "homepage_url": "https://github.com/YuriyWozniak/quickdial-ng",
  "developer": {
    "name": "YuriyWozniak",
    "url": "https://github.com/YuriyWozniak/quickdial-ng"
  },

  "icons": {
    "48": "img/icon.svg",
    "96": "img/icon.svg"
  },

  "permissions": [
    "storage",
    "bookmarks",
    "contextMenus",
    "tabs",
    "<all_urls>"
  ],

  "background": {
    "scripts": [
      "js/common.js",
      "js/themes.js",
      "js/background/app.js",
      "js/background/messages.js",
      "js/background/settings.js",
      "js/background/language.js",
      "js/background/images.js",
      "js/background/backup.js",
      "js/background/menus.js",
      "js/background/bookmarks.js",
      "js/background/siteinfos.js",
      "js/background/siteicons.js",
      "js/background/iconsets.js",
      "js/background/gridnodes.js",
      "js/background/main.js"
    ]
  },
  
  "browser_action": {
    "default_icon": "img/icon.svg",
    "theme_icons": [
      { "light": "img/icon-light.svg", "dark": "img/icon-dark.svg", "size": 16 },
      { "light": "img/icon-light.svg", "dark": "img/icon-dark.svg", "size": 32 }
    ]
  },

  "options_ui": {
    "page": "html/settings.html",
    "open_in_tab": true,
    "browser_style": false
  },

  "chrome_url_overrides" : {
    "newtab": "dial.html"
  },

  "chrome_settings_overrides": {
    "homepage": "dial.html"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "quickdial-ng@yuriywozniak",
      "strict_min_version": "140.0",
      "update_url": "https://raw.githubusercontent.com/YuriyWozniak/quickdial-ng/develop/updates.json",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "default_locale": "en"
}

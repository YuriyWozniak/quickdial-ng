{
  "name": "quickdial-ng-tests",
  "private": true,
  "description": "Unit tests, integration tests and benchmarks for Quick Dial NG. See README.md.",
  "scripts": {
    "test": "node --test \"unit/*.test.js\" && node run.js",
    "test:unit": "node --test \"unit/*.test.js\"",
    "test:integration": "node run.js",
    "coverage": "node run.js --coverage",
    "bench": "node bench/run.js",
    "screenshots": "node screenshots/make-screenshots.js"
  },
  "dependencies": {
    "pixelarticons": "^2.4.2",
    "playwright": "^1.50.0"
  }
}
